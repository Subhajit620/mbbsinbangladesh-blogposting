# --- Required ---
# MongoDB connection string (MongoDB Atlas recommended for hosting)
MONGODB_URI="mongodb+srv://aspiringlifedrive_db_user:Magicalthread786%23@cluster0.ng665uf.mongodb.net/mbbsbangladesh?retryWrites=true&w=majority"

# Port the server listens on. Most hosts (Render, Railway, Heroku, etc.)
# set PORT automatically — leave this unset there.
PORT="5001"

# --- Optional: image uploads ---
# If not set (or left as "dummy"), uploaded images are stored on the local
# disk under /uploads and served from the same server.
CLOUDINARY_CLOUD_NAME="dummy"
CLOUDINARY_API_KEY="dummy"
CLOUDINARY_API_SECRET="dummy"

# --- Optional: status-update emails to applicants ---
EMAIL_USER="you@gmail.com"
EMAIL_PASS="your-gmail-app-password"

# --- Optional: CORS ---
# Only needed for a split deploy (frontend hosted separately from the API).
# Comma-separated list of allowed origins. Leave unset to allow all.
# CORS_ORIGIN="https://your-frontend.example.com"

# --- Optional: SEO & Sitemap Public Base URL ---
# Used for canonical URLs, Open Graph tags, JSON-LD, and /sitemap.xml generation.
# Defaults automatically to the incoming request's protocol + host if unset.
# SITE_URL="https://your-domain.com"

# --- Optional: Admin API Authorization Token ---
# Defaults to "aspiring_life_auth_token" matching AdminLoginPage.tsx
# ADMIN_AUTH_TOKEN="aspiring_life_auth_token"
